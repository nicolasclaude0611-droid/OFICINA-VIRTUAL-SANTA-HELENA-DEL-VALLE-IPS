{
  "extraKnownMarketplaces": {
    "hyperframes": {
      "source": {
        "source": "github",
        "repo": "heygen-com/hyperframes"
      }
    },
    "claude-watch": {
      "source": {
        "source": "github",
        "repo": "taoufik123-collab/claude-watch"
      }
    }
  },
  "enabledPlugins": {
    "hyperframes@hyperframes": true,
    "watch@claude-watch": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v yt-dlp >/dev/null 2>&1 || pip install -q --break-system-packages yt-dlp >/dev/null 2>&1 || true",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
